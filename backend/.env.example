# Postgres connection string. asyncpg DSN format (no +asyncpg prefix).
# Host port is 5433 because docker-compose maps it there; the container itself
# listens on 5432.
DATABASE_URL=postgresql://inventory:inventory@localhost:5433/inventory

# dev | staging | production.
# Outside "dev" the app refuses to start while JWT_SECRET is still a
# placeholder, and scripts/seed.py refuses to run at all.
ENVIRONMENT=dev

# Must be at least 32 characters, and outside dev must not be the example value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-64-character-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

POOL_MIN_SIZE=2
POOL_MAX_SIZE=10
SQL_ECHO=false