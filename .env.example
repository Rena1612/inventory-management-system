# Copy to .env (root) for docker compose, and to backend/.env for the API.
# Never commit a real .env — only this example file is tracked.

# ---------------------------------------------------------------------------
# Docker Compose (root .env)
# ---------------------------------------------------------------------------

# Local-only defaults. A local PostgreSQL install commonly owns port 5432, so
# the container is published on 5433 by default.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
POSTGRES_HOST_PORT=5433

# Host port the API is published on.
API_HOST_PORT=8000

# ---------------------------------------------------------------------------
# Backend (backend/.env)
# ---------------------------------------------------------------------------

# asyncpg DSN, no +asyncpg prefix. Host port is 5433 because docker compose
# publishes the container there; the container itself listens on 5432.
DATABASE_URL=postgresql://inventory:inventory@localhost:5433/inventory

# MUST be at least 32 characters. Generate one per environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-64-character-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080

# localhost and 127.0.0.1 are distinct origins to the browser.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

POOL_MIN_SIZE=2
POOL_MAX_SIZE=10
SQL_ECHO=false

# ---------------------------------------------------------------------------
# Dev seed (optional) — override so a shared environment has no known password
# ---------------------------------------------------------------------------

DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

# Baked into the client bundle at build time; must be NEXT_PUBLIC_ prefixed.
NEXT_PUBLIC_API_URL=http://localhost:8000